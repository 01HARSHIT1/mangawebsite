# Vercel ignore file - Optimized for build performance
node_modules
.next
.git
.vscode
.idea
*.log
*.md
!README.md

# Test files
test-*
comprehensive-test.*
quick-error-check.*
*-test.*
*.test.*

# Documentation
COMPREHENSIVE-*
FINAL-*
MANUAL-*
TESTING-*
USER-FLOW-*
ERROR-*
ROLE-BASED-*
DOCKER-*
VERCEL-*

# Archives
*.tar
*.tar.gz
*.zip

# Test data and uploads
testmanga/
public/manga-images/
public/manga-covers/
temp_magick/
temp_poppler/

# Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker files
docker-compose.yml
docker-compose.*.yml
docker-dev.yml
Dockerfile
Dockerfile.*
.dockerignore

# Scripts
deploy.sh
deploy.ps1
*.bat

# Database scripts
mongo-init.js
seed-database.js
fix-manga-cover.js
update-chapter-to-poppler.js
